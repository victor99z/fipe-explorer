{
  "name": "fipex-car-crawler",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "sample": "rm -f ./data/sample.db && DB_TYPE=sqlite DATABASE_URL=sqlite://./data/sample.db bun run src/index.ts --sample=3 --all-sites --page-start=1",
    "dev:fresh": "rm -f ./data/carros.db && DB_TYPE=sqlite DATABASE_URL=sqlite://./data/carros.db bun run src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean:olx": "bun run src/index.ts --clean-olx",
    "seed": "bun run src/index.ts --seed-only"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "pocketbase": "^0.26.5",
    "puppeteer": "^24.34.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
