# Persistence backend: "pocketbase" or "sqlite"
DB_TYPE=pocketbase

# PocketBase target (local: http://127.0.0.1:8090 or remote: https://pb.victorbernardes.dev)
POCKETBASE_URL=https://pb.victorbernardes.dev
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_TOKEN=
POCKETBASE_UPLOAD_IMAGES=true

# SQLite fallback configuration (when DB_TYPE=sqlite)
DATABASE_URL=sqlite://./data/carros.db

# Optional browser executable path override (auto-detected if omitted)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PUPPETEER_HEADLESS=true

# Crawler tuning
CRAWLER_MAX_PAGES=50
CRAWLER_DELAY_MS=2500
