# ==============================================================================
# FIPEX EXPLORER - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# --- Servidor Backend (FastAPI / Uvicorn) ---
HOST=0.0.0.0
PORT=8000

# --- Caminho do Dataset Parquet ---
# Caminho para o arquivo parquet (preferencialmente o enriquecido)
PARQUET_FILE=data/fipex-prices-enriched.parquet

# --- Confinamento e Recursos do DuckDB ---
# Limite máximo de memória RAM alocada para consultas DuckDB
DUCKDB_MAX_MEMORY=1GB

# Número de threads alocadas por consulta DuckDB
DUCKDB_THREADS=2

# Número máximo de consultas analíticas pesadas simultâneas no DuckDB
MAX_CONCURRENT_QUERIES=6

# Tempo máximo (em segundos) de espera na fila de concorrência antes de retornar 503
QUERY_TIMEOUT_SECONDS=5.0

# --- Blindagem e Proteção contra Abuso (Rate Limiting / DDoS Shield) ---
# Habilitar ou desabilitar o middleware de limitação de requisições (true/false)
RATE_LIMIT_ENABLED=true

# Limite sustentado de requisições por minuto por IP
RATE_LIMIT_PER_MINUTE=90

# Limite de rajada (burst) de requisições em uma janela curta de 5 segundos
RATE_LIMIT_BURST=25

# ==============================================================================
# CONFIGURAÇÕES DE DEPLOY (DOCKER COMPOSE & PRODUÇÃO)
# ==============================================================================

# Porta HTTP do Frontend exposta no host (padrão 8085)
FRONTEND_PORT=8085

# --- Cloudflare Tunnel (Zero Trust) ---
# Caso deseje rodar o túnel via Docker Compose, defina:
# COMPOSE_PROFILES=tunnel
# Token fornecido pelo painel do Cloudflare Zero Trust:
# 1. Acesse: Zero Trust Dashboard > Networks > Tunnels
# 2. Crie um tunnel do tipo "Cloudflared" e copie o token gerado.
# 3. Na aba "Public Hostnames", adicione o domínio desejado:
#    - Service: HTTP
#    - URL: frontend:80
# Cole o token abaixo:
CLOUDFLARE_TUNNEL_TOKEN=

# --- Automação do Dataset (fipex-updater) ---
# Intervalo em horas entre checagens no Hugging Face (padrão: 24 horas)
UPDATE_INTERVAL_HOURS=24


