# ==============================================================================
# FIPEX Explorer - Development Frontend Dockerfile (Vite HMR)
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Install dependencies cleanly using lockfile
COPY package.json package-lock.json ./
RUN npm install

# Expose Vite development server port
EXPOSE 3000

# Start Vite in development mode with HMR on all interfaces
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
